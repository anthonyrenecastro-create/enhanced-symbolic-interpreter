def score_runtime(program: Program, rt: Runtime, run_result: Dict[str, Any]) -> Dict[str, float]:
    valid_execution = 1.0 if run_result["success"] else 0.0
    transitions = min(1.0, rt.transitions / 8.0)
    memory_usage = min(1.0, len(rt.memory_bank) / 8.0)
    inter_domain = 1.0 if rt.has_true_interdomain_dependency() else 0.0

    repeated_attractors = 0
    for _, bucket in rt.attractor_table.items():
        for _, count in bucket.items():
            if count >= 2:
                repeated_attractors += 1
    attractor_stability = min(1.0, repeated_attractors / 8.0)
    task_completion = rt.task_score

    core = {
        "valid_execution": valid_execution,
        "transitions": transitions,
        "memory_usage": memory_usage,
        "inter_domain": inter_domain,
        "attractor_stability": attractor_stability,
        "task_completion": task_completion,
    }

    F_core = (
        2.5 * valid_execution
        + 1.0 * transitions
        + 0.4 * memory_usage
        + 2.0 * inter_domain
        + 0.6 * attractor_stability
        + 2.5 * task_completion
    )

    stmt_strings = flatten_statement_strings(program)
    instr_count = len(stmt_strings)

    P_instr_rep = count_instruction_repetition(stmt_strings)
    P_block_rep = count_duplicate_blocks(stmt_strings)
    P_null = count_null_ops(program)
    P_dead_write = dead_write_penalty(program, rt)
    P_length = length_penalty(instr_count)

    R_mem_useful = memory_usefulness_reward(rt)
    R_distinct = distinct_effect_reward(rt)
    R_state_prod = useful_state_reward(rt)
    R_pop_robust = population_robustness_reward(rt)
    R_eff = behavioral_efficiency_reward(core, instr_count)
    R_trace = trace_coherence_reward(rt)

    fitness = (
        F_core
        + 1.2 * R_eff
        + 1.0 * R_distinct
        + 1.0 * R_mem_useful
        + 1.2 * R_state_prod
        + 0.8 * R_pop_robust
        + 1.0 * R_trace
        - 1.5 * P_instr_rep
        - 2.0 * P_block_rep
        - 1.5 * P_null
        - 1.2 * P_dead_write
        - 0.8 * P_length
    )

    return {
        **core,
        "R_eff": R_eff,
        "R_distinct": R_distinct,
        "R_mem_useful": R_mem_useful,
        "R_state_prod": R_state_prod,
        "R_pop_robust": R_pop_robust,
        "R_trace": R_trace,
        "P_instr_rep": P_instr_rep,
        "P_block_rep": P_block_rep,
        "P_null": P_null,
        "P_dead_write": P_dead_write,
        "P_length": P_length,
        "instr_count": instr_count,
        "fitness": fitness,
        "distinct_emit_domains": len(rt.distinct_emitted_domains()),
        "distinct_coupled_domains": len(rt.distinct_coupled_domains()),
        "useful_state_count": rt.count_useful_states(),
    }


