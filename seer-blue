def count_instruction_repetition(stmt_strings: List[str]) -> float:
    n = len(stmt_strings)
    if n == 0:
        return 0.0
    counts = Counter(stmt_strings)
    return sum(max(0, c - 1) for c in counts.values()) / n

def count_duplicate_blocks(stmt_strings: List[str], min_block=2, max_block=5) -> float:
    n = len(stmt_strings)
    if n == 0:
        return 0.0
    penalty = 0.0
    for k in range(min_block, min(max_block, n) + 1):
        seen = Counter(tuple(stmt_strings[i:i+k]) for i in range(n - k + 1))
        penalty += sum(max(0, c - 1) * k for c in seen.values())
    return penalty / n

def is_constant_expr(expr) -> bool:
    return isinstance(expr, ConstExpr)

def count_null_ops(program: Program) -> float:
    stmts = program.body.statements
    n = len(stmts)
    if n == 0:
        return 0.0
    nulls = 0
    prev_output = None
    for s in stmts:
        if isinstance(s, AssignStmt) and isinstance(s.expr, VarExpr) and s.target == s.expr.name:
            nulls += 1
        elif isinstance(s, TickStmt) and isinstance(s.count_expr, ConstExpr) and int(s.count_expr.value) == 0:
            nulls += 1
        elif isinstance(s, IfStmt) and is_constant_expr(s.cond_expr):
            nulls += 1
        elif isinstance(s, OutputStmt) and isinstance(s.expr, ConstExpr):
            cur = s.expr.value
            if prev_output == cur:
                nulls += 1
            prev_output = cur
        else:
            prev_output = None
    return nulls / n

def dead_write_penalty(program: Program, rt: Runtime) -> float:
    stmt_strings = flatten_statement_strings(program)
    n = max(1, len(stmt_strings))

    assigned = []
    used = set()
    for s in program.body.statements:
        if isinstance(s, AssignStmt):
            assigned.append(s.target)
        txt = stmt_to_str(s)
        for v in VAR_NAMES:
            if v in txt and not (isinstance(s, AssignStmt) and s.target == v):
                used.add(v)

    unused_bindings = sum(1 for a in assigned if a not in used)

    write_counts = Counter(k for _, k, _ in rt.memory_writes)
    useful_reads = Counter(rec.key for rec in rt.memory_reads if (
        rec.changed_downstream and (rec.consumed_by_branch or rec.consumed_by_output)
    ))
    unused_memory_writes = sum(1 for k in write_counts if useful_reads.get(k, 0) == 0)

    return (unused_bindings + unused_memory_writes) / n

def memory_usefulness_reward(rt: Runtime) -> float:
    useful_hits = 0
    for rec in rt.memory_reads:
        if rec.changed_downstream and (rec.consumed_by_branch or rec.consumed_by_output):
            useful_hits += 1
    return useful_hits / (1 + len(rt.memory_writes))

def distinct_effect_reward(rt: Runtime) -> float:
    unique_emits = len(set((v, ch, dm) for _, v, ch, dm in rt.emitted_effects))
    unique_couplings = len(set(rt.coupling_effects))
    unique_field_updates = len(set((f, ch, dm) for _, f, ch, dm, _ in rt.field_updates))
    total_effects = len(rt.emitted_effects) + len(rt.coupling_effects) + len(rt.field_updates)
    return (unique_emits + unique_couplings + unique_field_updates) / (1 + total_effects)

def useful_state_reward(rt: Runtime) -> float:
    productive = 0
    total = 0
    for st in rt.all_states():
        total += 1
        if st.influenced_other_state and st.influenced_output:
            productive += 1
    return productive / (1 + total)

def population_robustness_reward(rt: Runtime) -> float:
    domain_counts = Counter()
    age_sum = 0
    survivors = 0

    for st in rt.active_states:
        domain_counts[(st.channel, st.domain)] += 1
        age_sum += st.age
        survivors += 1

    if survivors == 0:
        return 0.0

    spread = len(domain_counts) / max(1, rt.num_channels * rt.num_domains)
    avg_age = age_sum / survivors
    age_score = min(1.0, avg_age / 5.0)

    return 0.6 * spread + 0.4 * age_score

def behavioral_efficiency_reward(core_components: Dict[str, float], instr_count: int) -> float:
    T = core_components["transitions"]
    M = core_components["memory_usage"]
    I = core_components["inter_domain"]
    A = core_components["attractor_stability"]
    C = core_components["task_completion"]
    numer = 1.0 * T + 1.0 * M + 1.0 * I + 1.0 * A + 1.0 * C
    return numer / (1 + math.log(1 + instr_count))

def length_penalty(instr_count: int, k: int = 12) -> float:
    return instr_count / (instr_count + k) if instr_count > 0 else 0.0

def trace_coherence_reward(rt: Runtime) -> float:
    improving = 0
    total = 0
    for ev in rt.trace:
        if ev.opcode in {
            "EMIT", "COUPLE", "SET_FIELD", "MUTATE_FIELD", "UPDATE_MEMORY",
            "OUTPUT", "READ_MEMORY", "IF", "STATE_FIELD_UPDATE", "STATE_EMIT",
            "STATE_COUPLE", "STATE_MEMORY_WRITE"
        }:
            total += 1
            if ev.changed_downstream and (ev.task_score_after > ev.task_score_before):
                improving += 1
    return improving / max(1, total)


